# Local backend API
HOST=127.0.0.1
PORT=4050

# Azure SQL
# Keep the real password in Azure Key Vault or local untracked env only.
AZURE_SQL_CONNECTION_STRING="Server=tcp:ecoglobedevsql0722.database.windows.net,1433;Initial Catalog=sqldb-ecoglobe-dev;Persist Security Info=False;User ID=ecoglobeadmin;Password=<from-key-vault-sql-admin-password>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"

# Stripe
# Leave STRIPE_SECRET_KEY blank for local demo mode. When set, onboarding returns
# Stripe-hosted billing or Connect redirects instead of demo completion.
ECOGLOBE_WEB_URL=http://localhost:4040
STRIPE_SECRET_KEY=

# Resend email delivery (server-only; never expose in NEXT_PUBLIC_* variables)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@ecoglobeworld.com
# Keep local and test sends pointed at the requested test recipient.
ECOGLOBE_EMAIL_TEST_RECIPIENT=kate@leapprosolutions.com
ECOGLOBE_EMAIL_OVERRIDE_ALL=true

# DocuSign eSignature (server-only)
# Build/test in the DocuSign developer environment, then switch to production
# only after the integration key passes DocuSign Go-Live.
DOCUSIGN_ENVIRONMENT=demo
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_URI=https://demo.docusign.net
# Store the PEM private key in Azure Key Vault. For local use, escaped newlines are supported.
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_TEMPLATE_ID=
DOCUSIGN_BUYER_ROLE_NAME=Buyer
DOCUSIGN_SELLER_ROLE_NAME=Seller
DOCUSIGN_RETURN_URL=http://localhost:4040/signing/complete
DOCUSIGN_WEBHOOK_HMAC_SECRET=
# Container SAS must allow Create and Write. Completed PDFs and certificates are archived here.
AZURE_SIGNED_DOCUMENTS_CONTAINER_SAS_URL=

# Local-only demo accounts
# Required by POST /auth/dev/seed-demo-users and never returned by the API.
ECOGLOBE_DEMO_PASSWORD=
