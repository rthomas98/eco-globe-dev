# Local backend API
HOST=127.0.0.1
PORT=4050

# Azure SQL
# Keep the real password in Azure Key Vault or local untracked env only.
AZURE_SQL_CONNECTION_STRING="Server=tcp:ecoglobedevsql0722.database.windows.net,1433;Initial Catalog=sqldb-ecoglobe-dev;Persist Security Info=False;User ID=ecoglobeadmin;Password=<from-key-vault-sql-admin-password>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"

# Stripe
# Leave STRIPE_SECRET_KEY blank for local demo mode. When set, onboarding returns
# Stripe-hosted billing or Connect redirects instead of demo completion.
ECOGLOBE_WEB_URL=http://localhost:4040
STRIPE_SECRET_KEY=

# Local-only demo accounts
# Required by POST /auth/dev/seed-demo-users and never returned by the API.
ECOGLOBE_DEMO_PASSWORD=
