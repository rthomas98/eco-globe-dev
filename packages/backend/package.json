{
  "name": "@eco-globe/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --test src/stripe-webhook.test.ts src/stripe-setup.test.ts src/email.test.ts src/docusign.test.ts src/listing-routes.test.ts src/lab-routes.test.ts src/pilot-routes.test.ts src/sample-shipping-domain.test.ts src/sample-shipping-provider.test.ts src/demo-order-domain.test.ts src/logistics-routes.test.ts src/mvp.test.ts src/fedex-sandbox-provider.test.ts src/refund-domain.test.ts src/quantity-units.test.ts src/payment-receipt.test.ts src/rfq-regression.test.ts src/market-records.test.ts src/market-references.test.ts src/market-portfolios.test.ts src/listing-sds-requests.test.ts src/wanted-listing-domain.test.ts src/staff-alerts.test.ts",
    "db:migrate": "tsx src/apply-schema.ts",
    "db:seed": "tsx src/seed-demo-data.ts",
    "db:migrate:docusign": "tsx src/apply-schema.ts ../db/migrations/20260818_docusign.sql",
    "clean": "rm -rf dist node_modules",
    "test:market-records": "node --import tsx --test src/market-records.test.ts",
    "test:market-records:sql": "node --import tsx src/market-record-sql-smoke.ts",
    "test:market-portfolios": "node --import tsx --test src/market-portfolios.test.ts",
    "test:market-portfolios:sql": "node --import tsx src/market-portfolio-sql-smoke.ts",
    "test:listing-sds": "node --import tsx --test src/listing-sds-requests.test.ts",
    "test:listing-sds:sql": "node --import tsx src/listing-sds-sql-smoke.ts",
    "test:drafts:sql": "node --import tsx src/private-drafts-sql-smoke.ts",
    "test:staff-alerts": "node --import tsx --test src/staff-alerts.test.ts",
    "test:staff-alerts:sql": "node --import tsx src/staff-alerts-sql-smoke.ts"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.33.0",
    "dotenv": "^17.4.2",
    "exceljs": "4.4.0",
    "mssql": "^12.7.0",
    "pdf-lib": "1.17.1",
    "saxes": "6.0.0",
    "stripe": "22.6.2",
    "yauzl": "3.2.1"
  },
  "devDependencies": {
    "@eco-globe/typescript-config": "workspace:*",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.14.1",
    "@types/yauzl": "2.10.3",
    "tsx": "^4.23.1",
    "typescript": "^5.8.2"
  }
}
